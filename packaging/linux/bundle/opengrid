#!/bin/bash
# OpenGrid (the application): runs the bundled environment (Python, Qt, VTK, Netgen,
# OpenCASCADE), nothing from the system's Python or conda.
#   ./opengrid [project.ogp ...]
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/opengrid-env.sh"
exec python -m opengrid "$@"
